# --- Base de données ---
DATABASE_URL=postgresql://user:password@localhost:5432/jerymotro

# --- Google Earth Engine ---
# Mode d'authentification : Service Account par défaut.
# Pour utiliser volontairement l'authentification par navigateur, définir :
# GEE_AUTH_MODE=browser
GEE_AUTH_MODE=service_account

# Chemin vers le fichier JSON du Service Account.
# OBLIGATOIRE lorsque GEE_AUTH_MODE=service_account.
GEE_SERVICE_ACCOUNT_JSON_PATH=

# Projet Google Cloud / Earth Engine utilisé pour les requêtes.
# Utiliser le même projet que dans Unet-jerymotro.
GEE_PROJECT=

# --- Exécution automatique ---
ENABLE_AUTO_LABELING=true

# Optionnel : expression CRON standard (5 champs) pour le mode démon.
# Si définie, elle prime sur INTERVAL_MINUTES.
LABELING_CRON_EXPRESSION=0 */6 * * *

# Utilisé si LABELING_CRON_EXPRESSION n'est pas défini.
INTERVAL_MINUTES=360

# --- Réglages de lots (optionnels, valeurs par défaut = 500) ---
DB_BATCH_SIZE=500
GEE_BATCH_SIZE=500

# Optionnel : plafond de sécurité par exécution (ex: en CI)
MAX_RECORDS_PER_RUN=

# --- Répartition du travail entre 2 Web Services ---
# WORK=0 : pas de partitionnement (mode historique, un seul worker).
# WORK=1 : traite uniquement les IDs impairs.
# WORK=2 : traite uniquement les IDs pairs.
# Pour 2 Web Services sur la même DB : mettre WORK=1 sur le premier et WORK=2 sur le second.
WORK=1

# --- Filtrage métier (optionnel) ---
# Ne traiter que les détections d'une région donnée (colonne `region`).
REGION_FILTER=

# Si true, renseigne aussi la colonne métier préexistante `landcover`
# lorsqu'elle est NULL (jamais d'écrasement d'une valeur déjà présente).
SYNC_LANDCOVER_COLUMN=false

LOG_LEVEL=INFO
